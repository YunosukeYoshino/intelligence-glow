{
  "name": "intelligence-glow",
  "version": "0.2.0",
  "description": "Ambient viewport glow effects with glowing and Three.js renderers.",
  "license": "MIT",
  "keywords": [
    "viewport-glow",
    "glow",
    "threejs",
    "typescript"
  ],
  "homepage": "https://github.com/YunosukeYoshino/apple-intelligence-glow-ui#readme",
  "bugs": {
    "url": "https://github.com/YunosukeYoshino/apple-intelligence-glow-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YunosukeYoshino/apple-intelligence-glow-ui.git"
  },
  "type": "module",
  "main": "./dist/lib/index.js",
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "bun run build:lib",
    "build:demo": "vite build",
    "build:lib": "vite build --mode lib && tsc -p tsconfig.build.json && bun ./scripts/prepare-package.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run --environment jsdom",
    "smoke:pack": "bun ./scripts/smoke-pack.mjs",
    "prepublishOnly": "bun run check && bun run test && bun run build && bun run smoke:pack"
  },
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./three": {
      "types": "./dist/lib/three/index.d.ts",
      "import": "./dist/lib/three/index.js"
    },
    "./style.css": "./dist/lib/style.css"
  },
  "files": [
    "dist/lib",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "glowing": "^0.2.3"
  },
  "peerDependencies": {
    "three": "^0.183.2"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^26.1.0",
    "lucide-react": "^1.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vitest": "^3.2.4"
  }
}
